{
  "manifest_version": 3,
  "name": "Focus for YouTube",
  "version": "0.1.4",
  "description": "Hides recommendations, Shorts, comments, and autoplay, so you watch what you came for. Includes breaks and a work-hours schedule.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus for YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "autoplay.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
